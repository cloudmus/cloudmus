{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "track.json",
  "title": "Track",
  "type": "object",
  "required": ["id", "title", "artists", "durationMs"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "artists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "album": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "coverUrl": {"type": "string"}
      },
      "additionalProperties": false
    },
    "durationMs": {"type": "integer"},
    "coverUrl": {"type": "string"},
    "liked": {"type": "boolean"},
    "explicit": {"type": "boolean"}
  },
  "additionalProperties": false
}
