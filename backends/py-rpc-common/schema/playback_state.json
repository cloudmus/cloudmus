{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "playback_state.json",
  "title": "PlaybackState",
  "type": "object",
  "required": ["state"],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["idle", "playing", "paused", "buffering", "stopped"]
    },
    "trackId": {"type": "string"},
    "positionMs": {"type": "integer"},
    "durationMs": {"type": "integer"},
    "liked": {"type": "boolean"}
  },
  "additionalProperties": false
}
