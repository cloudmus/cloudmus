{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "playlist.json",
  "title": "Playlist",
  "type": "object",
  "required": ["id", "title", "trackCount", "kind"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "coverUrl": {"type": "string"},
    "trackCount": {"type": "integer"},
    "kind": {"type": "string", "enum": ["playlist", "liked", "radioStation"]}
  },
  "additionalProperties": false
}
