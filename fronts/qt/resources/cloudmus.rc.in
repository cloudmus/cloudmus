#include <winver.h>

#include "Version.h"

1 ICON "@CLOUDMUS_ICON_PATH@"

// FileDescription is the app's name wherever Windows shows one for the exe
// itself: in its notifications' header, the Task Manager, "Open with".
// Without it, Windows falls back to the file name, "cloudmus-qt.exe".
VS_VERSION_INFO VERSIONINFO
FILEVERSION CLOUDMUS_VERSION_MAJOR, CLOUDMUS_VERSION_MINOR, CLOUDMUS_VERSION_PATCH, 0
PRODUCTVERSION CLOUDMUS_VERSION_MAJOR, CLOUDMUS_VERSION_MINOR, CLOUDMUS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "CloudMus"
            VALUE "ProductName", "CloudMus"
            VALUE "InternalName", "cloudmus-qt"
            VALUE "OriginalFilename", "cloudmus-qt.exe"
            VALUE "FileVersion", CLOUDMUS_VERSION
            VALUE "ProductVersion", CLOUDMUS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
